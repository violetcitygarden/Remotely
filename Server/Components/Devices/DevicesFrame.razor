@attribute [Authorize]
@inherits AuthComponentBase

<section class="device-console" @onclick="ClearSelectedCard">
    <div class="console-titlebar">
        <div>
            <h3>Computadores</h3>
            <span>Gerenciamento e acesso remoto</span>
        </div>
        <div class="connection-summary">
            <span class="status-led online"></span>
            @OnlineDeviceCount online
            <span class="summary-separator">|</span>
            @OfflineDeviceCount offline
        </div>
    </div>

    <div id="deviceControlsWrapper" class="console-toolbar">
        <div class="toolbar-group">
            <label for="deviceGroupSelect">Grupo</label>
            <select id="deviceGroupSelect" class="form-select form-select-sm" @bind="_selectedGroupId">
                <option value="@_deviceGroupAll">Todos</option>
                <option value="@_deviceGroupNone">Sem grupo</option>
                @foreach (var group in _deviceGroups)
                {
                    <option @key="group.ID" value="@group.ID">@group.Name</option>
                }
            </select>
            <button class="classic-button" title="Ligar computadores offline deste grupo" @onclick="WakeDevices">
                <span class="oi oi-power-standby"></span>
                Ligar
            </button>
        </div>

        <div class="toolbar-group toolbar-search">
            <label for="deviceSearchInput">Localizar</label>
            <input id="deviceSearchInput"
                   class="form-control form-control-sm"
                   placeholder="Nome, usuário, IP, etiqueta..."
                   @bind="_filter"
                   @bind:event="oninput" />
        </div>

        <div class="toolbar-group">
            <label for="deviceSortSelect">Ordenar por</label>
            <select id="deviceSortSelect" class="form-select form-select-sm" @bind="_selectedSortProperty">
                <option value=""></option>
                @foreach (var prop in _sortableProperties)
                {
                    <option value="@prop.Name">@GetDisplayName(prop)</option>
                }
            </select>
            <button class="classic-button icon-only" title="Inverter ordem" @onclick="ToggleSortDirection">
                <span class="oi @GetSortIcon()"></span>
            </button>
        </div>

        <div class="toolbar-actions">
            <label class="offline-toggle" for="hideOfflineDevicesCheckbox">
                <input id="hideOfflineDevicesCheckbox" type="checkbox" @bind="_hideOfflineDevices" />
                Ocultar offline
            </label>
            <button class="classic-button" @onclick="SelectAllCards">
                <span class="oi oi-check"></span>
                Selecionar
            </button>
            <button class="classic-button primary" @onclick="HandleRefreshClicked">
                <span class="oi oi-reload"></span>
                Atualizar
            </button>
        </div>
    </div>

    <div id="deviceListDiv" @onclick:stopPropagation>
        <div class="device-list-header" aria-hidden="true">
            <span></span>
            <span>Computador</span>
            <span>Usuário</span>
            <span>Sistema</span>
            <span>Último contato</span>
            <span>CPU</span>
            <span>RAM</span>
            <span>Disco</span>
            <span>Ações</span>
        </div>

        <div class="device-list-body">
            @if (DisplayedDevices.Length == 0)
            {
                <div class="empty-list">Nenhum computador corresponde aos filtros atuais.</div>
            }
            else
            {
                @foreach (var device in DisplayedDevices)
                {
                    <CascadingValue Value="this">
                        <DeviceCard @key="device.ID" Device="device" />
                    </CascadingValue>
                }
            }
        </div>
    </div>

    <div class="console-statusbar">
        <span>@_filteredDevices.Count computador(es)</span>
        <span>Página @_currentPage de @TotalPages</span>
        <div class="pager">
            <button class="classic-button icon-only" title="Página anterior" @onclick="PageDown">
                <i class="oi oi-chevron-left"></i>
            </button>
            <input id="currentPageInput" pattern="[0-9]" @bind="_currentPage" @bind:event="oninput" />
            <button class="classic-button icon-only" title="Próxima página" @onclick="PageUp">
                <i class="oi oi-chevron-right"></i>
            </button>
            <select class="form-select form-select-sm" title="Computadores por página" @bind="_devicesPerPage">
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
                <option value="100">100 por página</option>
                <option value="200">200 por página</option>
            </select>
        </div>
    </div>

    <Terminal />
</section>
