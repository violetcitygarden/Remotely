@attribute [Authorize]
@inherits AuthComponentBase

<article @ref="_card"
         class="device-row @_theme @GetCardStateClass() @(IsSelected ? "selected" : null)"
         @onclick="ExpandCard"
         @onclick:stopPropagation
         @oncontextmenu="ContextMenuOpening"
         @oncontextmenu:preventDefault="_state == DeviceCardState.Normal"
         @oncontextmenu:stopPropagation="_state == DeviceCardState.Normal">

    <div class="device-row-summary">
        <div class="selection-cell">
            <input type="checkbox"
                   aria-label="Selecionar @Device.DeviceName"
                   checked="@IsSelected"
                   @onchange="ToggleIsSelected"
                   @onclick:stopPropagation />
        </div>

        <div class="computer-cell">
            <span class="device-status @(Device.IsOnline ? "online" : "offline")"
                  title="@(Device.IsOnline ? (IsOutdated ? "Online — agente desatualizado" : "Online") : "Offline")"></span>
            <span class="device-name">@Device.DeviceName</span>
            @if (!string.IsNullOrWhiteSpace(Device.Alias))
            {
                <span class="device-alias">(@Device.Alias)</span>
            }
        </div>

        <div class="truncate" title="@Device.CurrentUser">@GetCellValue(Device.CurrentUser)</div>
        <div class="truncate" title="@GetOperatingSystem()">@GetOperatingSystem()</div>
        <div class="truncate" title="@Device.LastOnline.ToString()">@GetLastSeenText()</div>
        <div class="numeric-cell">@MathHelper.GetFormattedPercent(Device.CpuUtilization)</div>
        <div class="numeric-cell">@MathHelper.GetFormattedPercent(Device.UsedMemoryPercent)</div>
        <div class="numeric-cell">@MathHelper.GetFormattedPercent(Device.UsedStoragePercent)</div>

        <div class="row-actions" @onclick:stopPropagation>
            <button class="row-button primary"
                    disabled="@(!Device.IsOnline)"
                    title="Controlar este computador"
                    @onclick="() => StartRemoteControl(false)">
                <i class="oi oi-laptop"></i>
                Controlar
            </button>
            <button class="row-button"
                    disabled="@(!Device.IsOnline)"
                    title="Abrir chat"
                    @onclick="StartChat">
                <i class="oi oi-chat"></i>
            </button>
            <button class="row-button"
                    title="@(IsExpanded ? "Fechar detalhes" : "Abrir detalhes")"
                    @onclick="ToggleDetails">
                <i class="oi @(IsExpanded ? "oi-chevron-up" : "oi-chevron-down")"></i>
            </button>
        </div>
    </div>

    @if (_fileUploadProgressLookup.Any())
    {
        <div class="transfer-strip">
            @foreach (var kvp in _fileUploadProgressLookup)
            {
                <span>@GetProgressMessage(kvp.Key)</span>
            }
        </div>
    }

    @if (IsExpanded)
    {
        <div class="details-panel" @onclick:stopPropagation>
            <div class="details-toolbar">
                <button class="row-button primary" disabled="@(!Device.IsOnline)" @onclick="() => StartRemoteControl(false)">
                    <i class="oi oi-laptop"></i>
                    Controle remoto
                </button>
                <button class="row-button" disabled="@(!Device.IsOnline)" @onclick="() => StartRemoteControl(true)">
                    <i class="oi oi-eye"></i>
                    Somente visualizar
                </button>
                <button class="row-button" disabled="@(!Device.IsOnline)" @onclick="StartChat">
                    <i class="oi oi-chat"></i>
                    Chat
                </button>
                <FileInputButton ClassNames="row-button" OnChanged="OnFileInputChanged">
                    <ButtonContent>
                        <i class="oi oi-data-transfer-upload"></i>
                        Enviar arquivo
                    </ButtonContent>
                </FileInputButton>
                <button class="row-button" @onclick="WakeDevice">
                    <i class="oi oi-power-standby"></i>
                    Ligar
                </button>
                <button class="row-button" @onclick="OpenDeviceDetails">
                    <i class="oi oi-external-link"></i>
                    Abrir em nova janela
                </button>
            </div>

            <div class="details-content">
                <div class="info-pane">
                    <h4>Informações do computador</h4>
                    <dl>
                        <dt>Status</dt>
                        <dd>@(Device.IsOnline ? "Online" : "Offline")</dd>
                        <dt>Nome</dt>
                        <dd>@GetCellValue(Device.DeviceName)</dd>
                        <dt>Usuário</dt>
                        <dd>@GetCellValue(Device.CurrentUser)</dd>
                        <dt>Sistema</dt>
                        <dd>@GetOperatingSystem()</dd>
                        <dt>Grupo</dt>
                        <dd>@GetDeviceGroupName()</dd>
                        <dt>CPU</dt>
                        <dd>@MathHelper.GetFormattedPercent(Device.CpuUtilization)</dd>
                        <dt>Memória</dt>
                        <dd>@MathHelper.GetFormattedPercent(Device.UsedMemoryPercent) de @Device.TotalMemory GB</dd>
                        <dt>Armazenamento</dt>
                        <dd>
                            @MathHelper.GetFormattedPercent(Device.UsedStoragePercent) de @Device.TotalStorage GB
                            <button class="text-command" @onclick="ShowAllDisks">ver discos</button>
                        </dd>
                        <dt>IP público</dt>
                        <dd>@GetCellValue(Device.PublicIP)</dd>
                        <dt>MAC</dt>
                        <dd>@GetCellValue(string.Join(", ", Device.MacAddresses ?? Array.Empty<string>()))</dd>
                        <dt>Agente</dt>
                        <dd>@GetCellValue(Device.AgentVersion) @(IsOutdated ? "(desatualizado)" : null)</dd>
                        <dt>ID</dt>
                        <dd class="device-id">@Device.ID</dd>
                    </dl>
                </div>

                <div class="settings-pane">
                    <h4>Identificação e organização</h4>
                    <EditForm Model="Device" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        <label>
                            Apelido
                            <InputText class="form-control form-control-sm" @bind-Value="Device.Alias" />
                            <ValidationMessage For="() => Device.Alias" />
                        </label>

                        <label>
                            Grupo
                            <InputSelect @bind-Value="Device.DeviceGroupID" class="form-select form-select-sm">
                                <option value="">Sem grupo</option>
                                @foreach (var group in _deviceGroups)
                                {
                                    <option @key="group.ID" value="@group.ID">@group.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Device.DeviceGroupID" />
                        </label>

                        <label>
                            Etiquetas
                            <InputText @bind-Value="Device.Tags" class="form-control form-control-sm" />
                            <ValidationMessage For="() => Device.Tags" />
                        </label>

                        <label>
                            Observações
                            <InputTextArea @bind-Value="Device.Notes" class="form-control notes-input"></InputTextArea>
                            <ValidationMessage For="() => Device.Notes" />
                        </label>

                        <ValidationSummary />

                        <div class="settings-actions">
                            <button type="submit" class="row-button primary">Salvar alterações</button>
                            <button type="button" class="row-button danger" @onclick="UninstallAgent">
                                Desinstalar agente
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</article>
